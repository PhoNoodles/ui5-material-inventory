{
  "_version": "1.12.0",
  "sap.app": {
    "id": "com.portfolio.materialinventory",
    "type": "application",
    "title": "Material Inventory Management",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {}
      }
    },
    "rootView": {
      "viewName": "com.portfolio.materialinventory.view.App",
      "type": "XML",
      "id": "app"
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "com.portfolio.materialinventory.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "name": "materialList",
          "pattern": "",
          "target": "main"
        },
        {
          "name": "materialDetail",
          "pattern": "materials/{materialId}",
          "target": "detail"
        }
      ],
      "targets": {
        "main": {
          "viewName": "Main",
          "viewId": "main"
        },
        "detail": {
          "viewName": "Detail",
          "viewId": "detail"
        }
      }
    }
  }
}
